<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>8</LangVersion>
        <Nullable>enable</Nullable>
        <PackageId>Instances</PackageId>
        <Title>Instances</Title>
        <Authors>Malte Rosenbjerg</Authors>
        <Description>A .NET Standard Process wrapper with an elegant API, for both asyncronous and syncronous use, providing both Events and support for Tasks with cancellation support</Description>
        <Copyright>Rosenbjerg Softworks</Copyright>
        <PackageProjectUrl>https://github.com/rosenbjerg/Instances</PackageProjectUrl>
        <PackageTags>instances instance process async task events run exec</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageVersion>3.1.0</PackageVersion>
        <PackageReleaseNotes>- Fix WaitForExitAsync deadlock when cancellation races process exit (#10)
- Complete WaitForExitAsync even when an Exited handler throws
- Dispose the cancellation registration when the instance is disposed</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/rosenbjerg/Instances</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <ItemGroup>
      <Content Include="..\README.md">
        <Link>README.md</Link>
      </Content>
    </ItemGroup>

</Project>
